{
  "name": "wireframe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "firebase emulators:exec --only firestore --project demo-wireframe-rules \"node --test firestore.rules.test.js\"",
    "test:cad": "tsc src/lib/cad-engine.ts --outDir .cadcheck --module commonjs --target es2020 --moduleResolution node --skipLibCheck --esModuleInterop && node -e \"require('fs').writeFileSync('.cadcheck/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\" && node --test cad-engine.test.cjs",
    "test:brep": "node run-brep-tests.mjs"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@developer-hub/liquid-glass": "^1.2.3",
    "@jscad/io": "^2.4.12",
    "@jscad/modeling": "^2.12.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@stripe/stripe-js": "^8.6.0",
    "@tailwindcss/vite": "^4.1.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.24",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.553.0",
    "mathjs": "^15.1.0",
    "nodemailer": "^7.0.11",
    "ogl": "^1.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.6",
    "replicad": "^1.1.0",
    "replicad-opencascadejs": "^1.1.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.181.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "firebase-tools": "^15.30.1",
    "globals": "^16.4.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
